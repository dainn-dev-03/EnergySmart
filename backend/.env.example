# Sao chép file này thành backend/.env rồi điền giá trị thật. Không commit .env.

# ===== Database (PostgreSQL) =====
# Cách 1: khai báo từng thành phần
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=energy_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# DB riêng cho pytest: các bảng bị xóa và tạo lại mỗi lần chạy test.
# Phải khác POSTGRES_DB. Nếu chưa có, pytest sẽ tự tạo (user cần quyền CREATEDB).
POSTGRES_TEST_DB=energy_management_test
# Số giây chờ kết nối PostgreSQL trước khi báo lỗi
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Cách 2: một URL duy nhất (nếu đặt thì được ưu tiên hơn cách 1)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/energy_management

# ===== Security =====
# Bắt buộc >= 32 ký tự (app từ chối khởi động nếu ngắn hơn). Tạo secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ===== Application =====
DEBUG=false
CORS_ORIGINS=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ===== Seed / demo (chỉ dùng bởi: python -m app.seed.seed_database) =====
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@energysmart.vn
# Mật khẩu cho 2 tài khoản demo "manager" và "viewer" (bỏ trống thì không tạo)
SEED_DEMO_PASSWORD=demo123
# Số ngày dữ liệu lịch sử theo giờ khi seed lần đầu, và random seed để dữ liệu tái lập được
SEED_DAYS=90
SEED_RANDOM_SEED=42
